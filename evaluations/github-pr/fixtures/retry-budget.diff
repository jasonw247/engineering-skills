+
+def test_budget_exhaustion_fails_fast(fake_transport, fake_clock):
+    fake_transport.fail_always()
+    client = SyncClient(fake_transport, retry_budget=2)
+    client.budget.clock = fake_clock
+    with pytest.raises(RetryBudgetExceeded):
+        client.send(req)
+    assert fake_transport.calls == 3
+
+
+def test_budget_refills(fake_clock):
+    budget = RetryBudget(per_minute=6, clock=fake_clock)
+    for _ in range(6):
+        assert budget.take()
+    assert not budget.take()
+    fake_clock.advance(10)
+    assert budget.take()
