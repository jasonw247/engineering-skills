 import time
 
-from .errors import SyncError
+from .errors import RetryBudgetExceeded, SyncError
+
+
+class RetryBudget:
+    """Retries shared by every request on one client, refilled over time."""
+
+    def __init__(self, per_minute, clock=time.monotonic):
+        self.per_minute = per_minute
+        self.clock = clock
+        self.tokens = float(per_minute)
+        self.updated = clock()
+
+    def take(self):
+        now = self.clock()
+        self.tokens = min(self.per_minute, self.tokens + (now - self.updated) * self.per_minute / 60)
+        self.updated = now
+        if self.tokens < 1:
+            return False
+        self.tokens -= 1
+        return True
 
 
 class SyncClient:
-    def __init__(self, transport, max_attempts=5):
+    def __init__(self, transport, max_attempts=5, retry_budget=10):
         self.transport = transport
         self.max_attempts = max_attempts
+        self.budget = RetryBudget(retry_budget)
 
     def send(self, request):
         for attempt in range(self.max_attempts):
             try:
                 return self.transport.send(request)
             except SyncError:
-                time.sleep(2 ** attempt)
+                if attempt + 1 == self.max_attempts or not self.budget.take():
+                    raise RetryBudgetExceeded(request.id)
+                time.sleep(2 ** attempt)
-        raise SyncError("exhausted attempts")
